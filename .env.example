# 열린국회정보 Open API (open.assembly.go.kr)
# 무료 발급, 미발급 시 sample 키로 최대 10건 테스트 가능
ASSEMBLY_API_KEY=sample

# 국회도서관 발언빅데이터 (dataset.nanet.go.kr) - 가입 후 발급
NANET_API_KEY=

# 공공데이터포털 국회사무처_회의록 정보 API (보조 소스)
DATA_GO_KR_API_KEY=

# GCP / Vertex AI / Gemini / ADK
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=

# 웹 검색 도구 (뉴스 2차 출처 조회용 - 실제 채택 도구에 맞게 키 이름 조정 가능)
WEB_SEARCH_API_KEY=

# 저장소
SQLITE_PATH=./db/uijeonggirok.sqlite3
CHROMA_PERSIST_DIR=./db/chroma
CHROMA_COLLECTION_NAME=speeches

# 백엔드 (콤마로 구분된 origin 목록)
CORS_ORIGINS=http://localhost:5173
