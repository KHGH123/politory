# 열린국회정보 Open API (open.assembly.go.kr)
# 무료 발급, 미발급 시 sample 키로 최대 10건 테스트 가능
ASSEMBLY_API_KEY=sample

# 국회도서관 발언빅데이터 (dataset.nanet.go.kr) - 가입 후 발급
NANET_API_KEY=

# 공공데이터포털 국회사무처_회의록 정보 API (보조 소스)
DATA_GO_KR_API_KEY=

# GCP / Vertex AI / Gemini / ADK (Vertex AI 인증 방식 사용 — API 키 대신 gcloud 인증)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=
MODEL=gemini-3.5-flash

# 웹 검색 도구 (뉴스 2차 출처 조회용 - 실제 채택 도구에 맞게 키 이름 조정 가능)
WEB_SEARCH_API_KEY=

# NAVER API HUB 뉴스 검색 (agent/tools/web_search_tool.py) — 발급은
# https://api.ncloud-docs.com/docs/naver-api-hub-search-news 참고.
# 이름에 하이픈이 없어야 한다 — Cloud Run이 하이픈 포함 env 이름을
# 컨테이너 프로세스에 주입하지 않는 걸 실측으로 확인함(config.py 참고).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 저장소
SQLITE_PATH=./db/uijeonggirok.sqlite3

# BigQuery (국회의원 정형 데이터 — DB는 다른 팀원이 적재, 여기선 조회만)
# BIGQUERY_PROJECT를 비워두면 GOOGLE_CLOUD_PROJECT를 그대로 쓴다. assembly 데이터셋이
# Vertex AI/Gemini와 다른 GCP 프로젝트에 있으면 여기만 따로 채운다.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_MEMBERS_TABLE=mps

# Vertex AI Search (RAG) — 콘솔에서 데이터스토어+앱 만든 뒤 앱 ID 입력
SEARCH_PROJECT_ID=
SEARCH_APP_ID=
SEARCH_LOCATION=global

# BigQuery
BQ_PROJECT_ID=
BQ_DATASET=


# 백엔드 (콤마로 구분된 origin 목록)
CORS_ORIGINS=http://localhost:5173

# A2A 서버(agent/agent.py의 a2a_app) 바인딩 — uvicorn agent.agent:a2a_app 실행 시 사용
A2A_HOST=localhost
A2A_PORT=8001
